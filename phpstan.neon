parameters:
	# slowly increase
	level: 5
	paths:
		- src/
		- tests/
		- examples/
	
	typeAliases:
		PHPStanTypeAlias_InternalOptions: 'array<string, bool|int|null|string|\alsvanzelf\jsonapi\enums\ContentTypeEnum|PHPStanTypeAlias_Document>'
		PHPStanTypeAlias_Document: 'array<string, mixed>'
	
	treatPhpDocTypesAsCertain: true
	
	strictRules:
		allRules: false
	
	reportUnmatchedIgnoredErrors: true
	ignoreErrors:
		# add cases to ignore because they are too much work for now
		# @see https://phpstan.org/user-guide/ignoring-errors#ignoring-in-configuration-file
